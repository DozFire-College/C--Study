<Window x:Class="ImageResizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="500" Width="1018">
    <Grid Margin="10,31,10,17">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="937*"/>
            <ColumnDefinition Width="45*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Image x:Name="imageControl" 
               Source="/photo2024.jpg"
               Stretch="Uniform"
               HorizontalAlignment="Left"
               VerticalAlignment="Center"
               Margin="288,0,0,0" Grid.Column="1"/>
        <StackPanel Grid.Row="1" Margin="272,10,0,10" Orientation="Horizontal" HorizontalAlignment="Left" Grid.Column="1">
            <Label Content="Размер:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Slider x:Name="sizeSlider" 
                    Width="300" 
                    Minimum="10" 
                    Maximum="200" 
                    Value="100"
                    TickFrequency="10" 
                    IsSnapToTickEnabled="True"
                    VerticalAlignment="Center"
                    ValueChanged="SizeSlider_ValueChanged"/>
            <Label x:Name="sizeLabel" Content="100%" Width="50" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>