<Window x:Class="WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="431" Width="897">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListBox x:Name="MainListBox" Grid.Row="0" Margin="0,0,0,10"/>

        <StackPanel Orientation="Horizontal" Margin="10,314,390,10">
            <Button x:Name="AddButton" Content="Добавить" Width="69" Click="AddButton_Click" Height="29"/>
            <TextBox x:Name="InputTextBox" Width="196" Height="30"/>
        </StackPanel>

        <Button x:Name="DeleteButton" Grid.Row="2" Content="Удалить выбранное" 
                Click="DeleteButton_Click"/>
    </Grid>
</Window>