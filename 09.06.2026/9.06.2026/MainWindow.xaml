<Window x:Class="ListViewExample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="476" Width="1051">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ListView x:Name="lvData" 
                  Grid.Row="0" 
                  SelectionMode="Single"
                  Margin="0,0,0,10">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ID" Width="50" DisplayMemberBinding="{Binding Id}"/>
                    <GridViewColumn Header="Имя" Width="150" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Город" Width="150" DisplayMemberBinding="{Binding City}"/>
                </GridView>
            </ListView.View>
        </ListView>
        <Button x:Name="button1" 
                Grid.Row="1" 
                Content="Перенести выбранную строку"
                Click="Button1_Click"
                Height="35"
                Margin="0,0,0,10"/>
        
        <StackPanel Grid.Row="2">
            <Label x:Name="label1" 
                   Content="ID: " 
                   FontSize="14" 
                   Margin="0,0,0,5"/>
            <Label x:Name="label2" 
                   Content="Имя: " 
                   FontSize="14" 
                   Margin="0,0,0,5"/>
            <Label x:Name="label3" 
                   Content="Город: " 
                   FontSize="14" 
                   Margin="0,0,0,5"/>
        </StackPanel>
    </Grid>
</Window>