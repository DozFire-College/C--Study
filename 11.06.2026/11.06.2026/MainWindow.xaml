<Window x:Class="ScreamerApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow1" Height="419" Width="941"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="TimerText" Text="5" FontSize="48" 
                       HorizontalAlignment="Center" Margin="10" 
                       Foreground="Red"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="StartButton" Content="Запустить" 
                        Width="100" Height="30" Margin="5" 
                        Click="StartButton_Click"/>
                <Button x:Name="StopButton" Content="Остановить" 
                        Width="100" Height="30" Margin="5" 
                        Click="StopButton_Click" IsEnabled="False"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>