<Window x:Class="WpfApp7.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp7"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBox x:Name="textbox1" 
                 Grid.Row="0" 
                 Grid.Column="0" 
                 Grid.ColumnSpan="4"
                 Height="50" 
                 Margin="5"
                 FontSize="24"
                 TextAlignment="Right"
                 IsReadOnly="True"
                 Text="0"
                 VerticalContentAlignment="Center"/>

        <Button Content="CE" Grid.Row="1" Grid.Column="1" Margin="5,5,5,5" 
                FontSize="16" Click="ClearEntry_Click" Background="#FFE0E0E0"/>
        <Button Content="C" Grid.Row="1" Margin="5,5,5,5" 
                FontSize="16" Click="Clear_Click" Background="#FFE0E0E0"/>
        <Button Content="/" Grid.Row="1" Grid.Column="3" Margin="5" 
                FontSize="16" Click="Operation_Click" Background="#FFFFB74D"/>
        <Button Content="=" Grid.Column="2" Margin="5,5,5,5"
                FontSize="16" Click="Equally_Click" Background="#FFE0E0E0" Grid.Row="1"/>
        <Button Content="7" Grid.Row="2" Grid.Column="0" Margin="5" 
                FontSize="16" Click="Number_Click"/>
        <Button Content="8" Grid.Row="2" Grid.Column="1" Margin="5" 
                FontSize="16" Click="Number_Click"/>
        <Button Content="9" Grid.Row="2" Grid.Column="2" Margin="5" 
                FontSize="16" Click="Number_Click"/>
        <Button Content="*" Grid.Row="2" Grid.Column="3" Margin="5" 
                FontSize="16" Click="Operation_Click" Background="#FFFFB74D"/>

        <Button Content="4" Grid.Row="3" Grid.Column="0" Margin="5" 
                FontSize="16" Click="Number_Click"/>
        <Button Content="5" Grid.Row="3" Grid.Column="1" Margin="5" 
                FontSize="16" Click="Number_Click"/>
        <Button Content="6" Grid.Row="3" Grid.Column="2" Margin="5" 
                FontSize="16" Click="Number_Click"/>
        <Button Content="-" Grid.Row="3" Grid.Column="3" Margin="5" 
                FontSize="16" Click="Operation_Click" Background="#FFFFB74D"/>

        <Button Content="1" Grid.Row="4" Grid.Column="0" Margin="5" 
                FontSize="16" Click="Number_Click"/>
        <Button Content="2" Grid.Row="4" Grid.Column="1" Margin="5" 
                FontSize="16" Click="Number_Click"/>
        <Button Content="3" Grid.Row="4" Grid.Column="2" Margin="5" 
                FontSize="16" Click="Number_Click"/>
        <Button Content="+" Grid.Row="4" Grid.Column="3" Margin="5" 
                FontSize="16" Click="Operation_Click" Background="#FFFFB74D"/>
    </Grid>
</Window>
